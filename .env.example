# USDA FoodData Central API Key
# Get your free API key from: https://fdc.nal.usda.gov/api-key-signup.html
# Free tier: 1,000 requests/hour
VITE_USDA_API_KEY=your_usda_api_key_here

# FatSecret Platform API OAuth2 Credentials
# Get your credentials from: https://platform.fatsecret.com/api/
# Note: Requires IP whitelisting for production use
FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here

# Backend URL (for FatSecret OAuth2 proxy)
# Default for local development
VITE_BACKEND_URL=http://localhost:3001
