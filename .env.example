# USDA FoodData Central API Key (Good for generic foods)
# Get your free API key from: https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=your_api_key_here

# CalorieNinjas API Key (Best for Indian foods - Primary)
# Get your free API key from: https://calorieninjas.com/api
# Free tier: 5,000 requests/month
VITE_CALORIENINJAS_API_KEY=your_api_key_here

# Edamam Food Database API (Good for international coverage - Secondary)
# Get your free API key from: https://developer.edamam.com/food-database-api
# Free tier: 10,000 requests/month
VITE_EDAMAM_APP_ID=your_app_id_here
VITE_EDAMAM_APP_KEY=your_app_key_here
